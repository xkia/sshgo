#!/usr/bin/expect

# Unified SSH Login Script for sshgo

encoding system utf-8

proc configure_utf8_channel {channel} {
    catch {fconfigure $channel -encoding utf-8}
}

configure_utf8_channel stdin
configure_utf8_channel stdout
configure_utf8_channel stderr
catch {configure_utf8_channel $user_spawn_id}

# Default values
set host ""
set user ""
set port "22"
set jumper ""
set jump_mode "shell"
set id_file ""
set jumper_id_file ""
set mfa_secret ""
set jumper_mfa_secret ""
set jumper_pass ""
set target_pass ""
set remote_command ""
set print_command ""
set session_context ""
set session_ready_re {a^}
set session_unavailable_re {a^}
set custom_proxy_command ""
set jumper_proxy_command ""
set tunnel_proxy_command ""
set connection_stage "target"
set host_key_checking "accept-new"
set python_executable "python3"
set has_tty [expr {![catch {stty size}]}]
set shell_prompt_re {[$#%>❯➜] ?$}
# zsh and readline emit the bracketed-paste enable sequence immediately before
# reading input, so it also marks a ready shell. Rich prompts such as Starship put
# right-side text and cursor escapes after the glyph, which leaves the glyph out of
# the buffer tail and keeps the prompt pattern above from ever matching.
set bracketed_paste_re {\x1b\[\?2004h}
set shell_ready_re "(?:$shell_prompt_re|$bracketed_paste_re)"

# Argument parser
set i 0
while {$i < $argc} {
    set arg [lindex $argv $i]
    incr i
    if {$i >= $argc} {
        puts "Error: missing value for $arg"
        exit 1
    }
    set value [lindex $argv $i]
    incr i
    switch -exact -- $arg {
        "-session-context" { set session_context $value }
        "-h"   { set host $value }
        "-u"   { set user $value }
        "-p"   { set port $value }
        "-J"   { set jumper $value }
        "-jump-mode" { set jump_mode $value }
        "-i"   { set id_file $value }
        "-j-i" { set jumper_id_file $value }
        "-c"   { set remote_command $value }
        "-print-command" { set print_command $value }
        "-proxy-command" { set custom_proxy_command $value }
        "-j-proxy-command" { set jumper_proxy_command $value }
        "-tunnel-proxy-command" { set tunnel_proxy_command $value }
        "-host-key-checking" { set host_key_checking $value }
        default {
            puts "Error: unknown option $arg"
            exit 1
        }
    }
}

if {$host == "" || $user == ""} {
    puts "Usage: login.exp -h <host> -u <user> ..."
    exit 1
}

if {[info exists env(SSHGO_TARGET_PASS)]} {
    set target_pass $env(SSHGO_TARGET_PASS)
    unset env(SSHGO_TARGET_PASS)
}
if {[info exists env(SSHGO_JUMPER_PASS)]} {
    set jumper_pass $env(SSHGO_JUMPER_PASS)
    unset env(SSHGO_JUMPER_PASS)
}
if {[info exists env(SSHGO_MFA_SECRET)]} {
    set mfa_secret $env(SSHGO_MFA_SECRET)
    unset env(SSHGO_MFA_SECRET)
}
if {[info exists env(SSHGO_JUMPER_MFA_SECRET)]} {
    set jumper_mfa_secret $env(SSHGO_JUMPER_MFA_SECRET)
    unset env(SSHGO_JUMPER_MFA_SECRET)
}
if {[info exists env(SSHGO_PYTHON_EXECUTABLE)]} {
    set python_executable $env(SSHGO_PYTHON_EXECUTABLE)
    unset env(SSHGO_PYTHON_EXECUTABLE)
}

if {$remote_command != ""} {
    puts "Executing on $user@$host: $remote_command"
} else {
    # puts "Connecting to $user@$host..."
}

# Get auth.py path
set script_dir [file dirname [file normalize [info script]]]
set auth_py [file join $script_dir "auth.py"]

proc cleanup {} {
    global has_tty session_context
    if {$session_context != ""} {catch {ss_cleanup}}
    if {$has_tty} {
        catch {stty echo}
    }
}

proc fail {message code} {
    cleanup
    puts $message
    exit $code
}

proc shell_quote {value} {
    set escaped [string map {"'" "'\\''"} $value]
    return "'$escaped'"
}

proc common_ssh_options {host_key_checking} {
    set opts [list -o ConnectTimeout=10]
    if {$host_key_checking == "no"} {
        lappend opts -o StrictHostKeyChecking=no
        lappend opts -o UserKnownHostsFile=/dev/null
    } else {
        lappend opts -o StrictHostKeyChecking=$host_key_checking
    }
    return $opts
}

proc split_host_port {target default_port} {
    if {[regexp {^([^@]+@)?\[(.+)\]:([0-9]+)$} $target -> user_prefix host port]} {
        return [list "${user_prefix}${host}" $port]
    }
    if {[regexp {^([^@]+@)?\[(.+)\]$} $target -> user_prefix host]} {
        return [list "${user_prefix}${host}" $default_port]
    }
    if {[regexp {^(.+):([0-9]+)$} $target -> base port]} {
        set host_part $base
        if {[regexp {^[^@]+@(.+)$} $base -> host_part]} {}
        if {[string first ":" $host_part] < 0} {
            return [list $base $port]
        }
    }
    return [list $target $default_port]
}

proc prompt_token_boundary {ch side} {
    if {$ch == "" || $ch == " " || $ch == "\t"} {
        return 1
    }
    if {$side == "before"} {
        return [expr {[string first $ch {'"([}] >= 0}]
    }
    return [expr {[string first $ch {'")]:}] >= 0}]
}

proc prompt_token_matches {text token} {
    if {$token == ""} {
        return 0
    }

    set haystack [string tolower $text]
    set needle [string tolower $token]
    set haystack_length [string length $haystack]
    set needle_length [string length $needle]
    set search_from 0

    while {$search_from <= $haystack_length} {
        set index [string first $needle $haystack $search_from]
        if {$index < 0} {
            return 0
        }

        set before ""
        if {$index > 0} {
            set before [string index $haystack [expr {$index - 1}]]
        }
        set after_index [expr {$index + $needle_length}]
        set after ""
        if {$after_index < $haystack_length} {
            set after [string index $haystack $after_index]
        }

        if {
            [prompt_token_boundary $before "before"]
            && [prompt_token_boundary $after "after"]
        } {
            return 1
        }
        set search_from [expr {$index + 1}]
    }
    return 0
}

proc prompt_line {buffer} {
    set normalized [string map [list "\r" "\n"] $buffer]
    return [lindex [split $normalized "\n"] end]
}

proc prompt_auth_stage {prompt} {
    global jumper jump_mode connection_stage user host id_file jumper_id_file
    if {$jumper == ""} {
        return "target"
    }
    if {$jump_mode == "shell"} {
        return $connection_stage
    }

    lassign [split_host_port $jumper "22"] jumper_target _
    set jumper_match 0
    set target_match 0
    if {$jumper_id_file != "" && [prompt_token_matches $prompt $jumper_id_file]} {
        set jumper_match 1
    }
    if {$id_file != "" && [prompt_token_matches $prompt $id_file]} {
        set target_match 1
    }
    if {[prompt_token_matches $prompt $jumper_target]} {
        set jumper_match 1
    }
    if {[prompt_token_matches $prompt "$user@$host"]} {
        set target_match 1
    }
    if {$jumper_match && !$target_match} {
        return "jumper"
    }
    if {$target_match && !$jumper_match} {
        return "target"
    }
    return ""
}

proc auth_response {stage kind} {
    global jumper_pass target_pass jumper_mfa_secret mfa_secret python_executable auth_py
    if {$kind == "password"} {
        if {$stage == "jumper"} {
            return $jumper_pass
        }
        if {$stage == "target"} {
            return $target_pass
        }
    }
    if {$kind == "mfa"} {
        if {$stage == "jumper" && $jumper_mfa_secret != ""} {
            return [exec $python_executable $auth_py - << $jumper_mfa_secret]
        }
        if {$stage == "target" && $mfa_secret != ""} {
            return [exec $python_executable $auth_py - << $mfa_secret]
        }
    }
    return ""
}

proc handle_auth_prompt {kind} {
    global expect_out
    set stage [prompt_auth_stage [prompt_line $expect_out(buffer)]]
    set response [auth_response $stage $kind]
    if {$response == ""} {
        if {$::session_context != ""} {ss_manual_auth; return 1}
        interact
        return 0
    }
    send "$response\r"
    return 1
}

proc shell_join {parts} {
    set quoted [list]
    foreach part $parts {
        lappend quoted [shell_quote $part]
    }
    return [join $quoted " "]
}

proc target_ssh_command {host port user id_file} {
    set parts [list ssh]
    if {$::session_context != "" && $::ss_state != "disabled"} {
        set parts [list [dict get $::ss_data remote_ssh] {*}[ss_master_options [dict get $::ss_data remote_socket]] {*}[common_ssh_options $::host_key_checking]]
    }
    if {$port != "" && $port != "22"} {
        lappend parts -p $port
    }
    if {$id_file != ""} {
        lappend parts -i $id_file
    }
    if {$::session_context != "" && $::ss_state != "disabled"} {
        lappend parts -tt "$user@$host" [ss_call startup [dict get $::ss_data ready_nonce]]
    } else {lappend parts "$user@$host"}
    return [shell_join $parts]
}

if {$session_context != ""} {
    source [file join $script_dir session_shortcuts.exp]
    set session_ready_re "\\x1b\\]777;sshgo;ready;[dict get $ss_data ready_nonce]\\x07"
    set session_unavailable_re "\\x1b\\]777;sshgo;unavailable;[dict get $ss_data session]\\x07"
    trap {cleanup; exit 143} TERM
    trap {cleanup; exit 129} HUP
}

# Adjust window size on WINCH signal
trap {
    set rows [stty rows]
    set cols [stty columns]
    catch {stty rows $rows columns $cols < $spawn_out(slave,name)}
    if {$session_context != "" && [info exists ss_main_tty] && $ss_main_tty != ""} {
        catch {stty rows $rows columns $cols < $ss_main_tty}
    }
} WINCH

# Construct the SSH command. Nested hosts use serial login: first connect to the
# jump host, then run ssh to the target from the jump host shell. This supports
# jump hosts that disable TCP forwarding.
if {$jumper != "" && $jump_mode == "shell"} {
    set connection_stage "jumper"
    lassign [split_host_port $jumper "22"] jumper_target jumper_port
    set cmd [list ssh]
    foreach opt [common_ssh_options $host_key_checking] {
        lappend cmd $opt
    }
    if {$jumper_port != "" && $jumper_port != "22"} {
        lappend cmd -p $jumper_port
    }
    if {$jumper_id_file != ""} {
        lappend cmd -i $jumper_id_file
    }
    if {$jumper_proxy_command != ""} {
        lappend cmd -o "ProxyCommand=$jumper_proxy_command"
    }
    lappend cmd $jumper_target
} else {
    set cmd [list ssh]
    foreach opt [common_ssh_options $host_key_checking] {
        lappend cmd $opt
    }
    if {$port != ""} { lappend cmd -p $port }
    if {$id_file != ""} { lappend cmd -i $id_file }
    if {$jumper != "" && $jump_mode == "tunnel"} {
        if {$tunnel_proxy_command == ""} {
            fail "Error: missing tunnel proxy command." 1
        }
        lappend cmd -o "ProxyCommand=$tunnel_proxy_command"
    } elseif {$custom_proxy_command != ""} {
        lappend cmd -o "ProxyCommand=$custom_proxy_command"
    }
    lappend cmd "$user@$host"
}

if {$session_context != ""} {
    set cmd [linsert $cmd 1 {*}[ss_master_options [dict get $ss_data socket]]]
    lset cmd 0 [dict get $ss_data ssh]
    if {$connection_stage != "jumper"} {
        set cmd [linsert $cmd 1 -tt]
        lappend cmd [ss_call startup [dict get $ss_data ready_nonce]]
    }
}

if {$print_command != ""} {
    puts [shell_join $cmd]
    exit 0
}

set timeout 20

# Disable terminal echo to prevent password/username leakage when a TTY exists.
if {$has_tty} {
    stty -echo
}

# Print a clean connection message
if {$jumper != "" && $jump_mode == "shell"} {
    puts "Connecting to $jumper, then $user@$host..."
} elseif {$jumper != ""} {
    puts "Connecting to $user@$host through $jumper..."
} else {
    puts "Connecting to $user@$host..."
}
if {$session_context != ""} {puts [dict get $ss_data shortcuts_login_hint]}

# Spawn the SSH process
# Temporarily disable logging to hide the spawn command itself
log_user 0
spawn {*}$cmd
configure_utf8_channel $spawn_id
# Re-enable logging to show the user the remote shell
log_user 1

# Main expect loop
expect {
    -re $session_ready_re {
        set ss_state announced
        ss_interact; cleanup; exit 0
    }
    -re $session_unavailable_re {
        set ss_state disabled
        ss_message shortcuts_disabled
        ss_interact; cleanup; exit 0
    }
    -re {Are you sure you want to continue connecting.*yes/no} {
        send "yes\r"
        exp_continue
    }
    -re {(?i)((password|passphrase)[: ]*|enter passphrase for key [^\r\n]*:) *$} {
        if {[handle_auth_prompt "password"]} {
            exp_continue
        }
    }
    -re {(?i)(MFA|OTP|Verification code).*:} {
        if {[handle_auth_prompt "mfa"]} {
            exp_continue
        }
    }
    -re {(?i)Operation timed out} {
        fail "\nError: Connection to host timed out." 1
    }
    "Permission denied" {
        fail "\n\nAuthentication failed (Permission denied).\n" 1
    }
    "Connection timed out" {
        fail "\n\nConnection timed out.\n" 1
    }
    eof {
        fail "\n\nConnection closed unexpectedly.\n" 1
    }
    # Success condition: prompt glyph or line-editor readiness
    -re $shell_ready_re {
        if {$connection_stage == "jumper"} {
            set connection_stage "target"
            if {$session_context != ""} {ss_prepare_target}
            set target_cmd [target_ssh_command $host $port $user $id_file]
            if {$session_context != ""} {
                if {[catch {ss_wrap_target $target_cmd} wrapped]} {fail $wrapped 1}
                set target_cmd $wrapped
            }
            if {$session_context != "" && $ss_state != "disabled"} {
                ss_launch_target $target_cmd
            } else {send "$target_cmd\r"}
            exp_continue
        }

        if {$remote_command != ""} {
            # Scenario: An initial command is provided.
            send "$remote_command"
            send "\r"
            # Wait for the echo to ensure receipt.
            expect "$remote_command"
            # Wait for the next prompt to ensure execution is complete. If the
            # command exits the SSH session, treat EOF as a clean handoff result.
            expect {
                -re $shell_ready_re {
                    interact {
                        eof {
                            return
                        }
                    }
                }
                eof {
                    cleanup
                    exit 0
                }
            }
        } else {
            # Scenario: No initial command, go straight to interactive.
            if {$session_context != ""} {ss_interact; cleanup; exit 0}
            interact {
                eof {
                    return
                }
            }
        }
    }
    timeout {
        if {$remote_command == "" && $connection_stage != "jumper"} {
            if {$session_context != ""} {ss_interact; cleanup; exit 0}
            cleanup
            interact {
                eof {
                    return
                }
            }
            exit 0
        }
        fail "\n\nConnection timed out.\n" 1
    }
}

cleanup
