#!/usr/bin/expect

# SFTP File Transfer Script for sshgo

# Default values
set host ""
set user ""
set port "22"
set jumper ""
set id_file ""
set jumper_pass ""
set target_pass ""
set mfa_secret ""
set jumper_mfa_secret ""
set jump_mfa_used 0
set host_key_checking "accept-new"
set action ""
set local_path ""
set remote_path ""
set print_command ""
set custom_proxy_command ""
set tunnel_proxy_command ""
set has_tty [expr {![catch {exec sh -c {test -t 0}}]}]

# Argument parser
for {set i 0} {$i < $argc} {incr i} {
    set arg [lindex $argv $i]
    set value [lindex $argv [expr $i+1]]
    switch -exact -- $arg {
        "-h"        { set host $value }
        "-u"        { set user $value }
        "-P"        { set port $value }
        "-J"        { set jumper $value }
        "-i"        { set id_file $value }
        "-action"   { set action $value }
        "-local"    { set local_path $value }
        "-remote"   { set remote_path $value }
        "-print-command" { set print_command $value }
        "-proxy-command" { set custom_proxy_command $value }
        "-tunnel-proxy-command" { set tunnel_proxy_command $value }
        "-host-key-checking" { set host_key_checking $value }
    }
}

if {$host == "" || $user == "" || $action == "" || $local_path == "" || $remote_path == ""} {
    puts "Usage: sftp_login.exp -h <host> -u <user> -action <upload|download> -local <path> -remote <path>"
    exit 1
}

if {[info exists env(SSHGO_TARGET_PASS)]} {
    set target_pass $env(SSHGO_TARGET_PASS)
    unset env(SSHGO_TARGET_PASS)
}
if {[info exists env(SSHGO_JUMPER_PASS)]} {
    set jumper_pass $env(SSHGO_JUMPER_PASS)
    unset env(SSHGO_JUMPER_PASS)
}
if {[info exists env(SSHGO_MFA_SECRET)]} {
    set mfa_secret $env(SSHGO_MFA_SECRET)
    unset env(SSHGO_MFA_SECRET)
}
if {[info exists env(SSHGO_JUMPER_MFA_SECRET)]} {
    set jumper_mfa_secret $env(SSHGO_JUMPER_MFA_SECRET)
    unset env(SSHGO_JUMPER_MFA_SECRET)
}

# Get auth.py path
set script_dir [file dirname [file normalize [info script]]]
set auth_py [file join $script_dir "auth.py"]

proc cleanup {} {
    global has_tty
    if {$has_tty} {
        catch {stty echo}
    }
}

proc fail {message code} {
    cleanup
    puts $message
    exit $code
}

proc wait_exit_status {} {
    set wait_result [wait]
    if {[llength $wait_result] >= 4} {
        set exit_status [lindex $wait_result 3]
        if {[string is integer -strict $exit_status]} {
            return $exit_status
        }
    }
    catch {puts stderr "Warning: unexpected process wait result: $wait_result"}
    return 1
}

proc shell_quote {value} {
    set escaped [string map {"'" "'\\''"} $value]
    return "'$escaped'"
}

proc shell_join {parts} {
    set quoted [list]
    foreach part $parts {
        lappend quoted [shell_quote $part]
    }
    return [join $quoted " "]
}

# Create password queue
set password_queue [list]
if {$jumper_pass != ""} {
    lappend password_queue $jumper_pass
}
if {$target_pass != ""} {
    lappend password_queue $target_pass
}

# Adjust window size on WINCH signal
trap {
    set rows [stty rows]
    set cols [stty columns]
    stty rows $rows columns $cols < $spawn_out(slave,name)
} WINCH

# Construct the SFTP command
set cmd [list sftp -o ConnectTimeout=10]
if {$host_key_checking == "no"} {
    lappend cmd -o StrictHostKeyChecking=no
    lappend cmd -o UserKnownHostsFile=/dev/null
} else {
    lappend cmd -o StrictHostKeyChecking=$host_key_checking
}
if {$port != "22"} { lappend cmd -P $port }
if {$id_file != ""} { lappend cmd -i $id_file }
if {$jumper != ""} {
    if {$tunnel_proxy_command == ""} {
        fail "Error: missing tunnel proxy command." 1
    }
    lappend cmd -o "ProxyCommand=$tunnel_proxy_command"
} elseif {$custom_proxy_command != ""} {
    lappend cmd -o "ProxyCommand=$custom_proxy_command"
}
lappend cmd "$user@$host"

if {$print_command != ""} {
    puts [shell_join $cmd]
    exit 0
}

set timeout 20

# Disable terminal echo to prevent password/username leakage when a TTY exists.
if {$has_tty} {
    stty -echo
}

log_user 0
spawn {*}$cmd
log_user 1

puts "Connecting to $user@$host for $action..."

# Main expect loop for authentication
expect {
    -re {Are you sure you want to continue connecting.*yes/no} {
        send "yes\r"
        exp_continue
    }
    -re {(?i)(password|passphrase)[: ]*$} {
        if {[llength $password_queue] > 0} {
            set pass_to_send [lindex $password_queue 0]
            send "$pass_to_send\r"
            set password_queue [lrange $password_queue 1 end]
            exp_continue
        } else {
            interact
        }
    }
    -re {(?i)(MFA|OTP|Verification code).*:} {
        if {$jumper_mfa_secret != "" && $jump_mfa_used == 0} {
            set oath [exec python3 $auth_py - << $jumper_mfa_secret]
            send "$oath\r"
            set jump_mfa_used 1
            exp_continue
        }
        if {$mfa_secret != ""} {
            set oath [exec python3 $auth_py - << $mfa_secret]
            send "$oath\r"
            exp_continue
        }
        interact
    }
    -re {(?i)Operation timed out} {
        fail "\nError: Connection to host timed out." 1
    }
    "Permission denied" {
        fail "\n\nAuthentication failed (Permission denied).\n" 1
    }
    "Connection timed out" {
        fail "\n\nConnection timed out.\n" 1
    }
    eof {
        set exit_status [wait_exit_status]
        if {$exit_status == "0"} {
            fail "\n\nSFTP exited before opening a session.\n" 1
        }
        fail "\n\nSFTP failed before opening a session with exit status $exit_status.\n" 1
    }
    timeout {
        fail "\n\nConnection timed out.\n" 1
    }
    "sftp>" {
        # Authentication successful, perform file transfer
        if {$action == "upload"} {
            send "put \"$local_path\" \"$remote_path\"\r"
        } else {
            send "get \"$remote_path\" \"$local_path\"\r"
        }
        expect {
            -re {(?i)(^|\r|\n)(Failure:|Couldn't |Could not |No such file|Permission denied|Connection closed|File ("[^"\r\n]+"|[^\r\n]+) not found\.|(remote|local|dest) [^\r\n:]+: [^\r\n]+)} {
                fail "\nFile transfer failed.\n" 1
            }
            "sftp>" {
                # Transfer complete
            }
            eof {
                set exit_status [wait_exit_status]
                if {$exit_status == "0"} {
                    fail "\nFile transfer ended before completion.\n" 1
                }
                fail "\nFile transfer failed with exit status $exit_status.\n" 1
            }
            timeout {
                fail "\nFile transfer timed out.\n" 1
            }
        }
        send "bye\r"
        expect {
            eof {
                set exit_status [wait_exit_status]
                if {$exit_status != "0"} {
                    fail "\nSFTP exited with status $exit_status.\n" 1
                }
            }
            timeout {
                fail "\nSFTP did not exit cleanly.\n" 1
            }
        }
    }
}

cleanup
