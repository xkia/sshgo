#!/usr/bin/expect

# SFTP File Transfer Script for sshgo

encoding system utf-8

proc configure_utf8_channel {channel} {
    catch {fconfigure $channel -encoding utf-8}
}

configure_utf8_channel stdin
configure_utf8_channel stdout
configure_utf8_channel stderr
catch {configure_utf8_channel $user_spawn_id}

# Default values
set host ""
set user ""
set port "22"
set jumper ""
set id_file ""
set jumper_id_file ""
set jumper_pass ""
set target_pass ""
set mfa_secret ""
set jumper_mfa_secret ""
set host_key_checking "accept-new"
set action ""
set local_path ""
set remote_path ""
set print_command ""
set custom_proxy_command ""
set tunnel_proxy_command ""
set has_tty [expr {![catch {stty size}]}]
set batch_path ""
set stale_batch_seconds 86400
set interactive_prompt_seen 0
set interactive_user_handoff_started 0
set python_executable "python3"

# Argument parser
set i 0
while {$i < $argc} {
    set arg [lindex $argv $i]
    incr i
    if {$i >= $argc} {
        puts "Error: missing value for $arg"
        exit 1
    }
    set value [lindex $argv $i]
    incr i
    switch -exact -- $arg {
        "-h"        { set host $value }
        "-u"        { set user $value }
        "-P"        { set port $value }
        "-J"        { set jumper $value }
        "-i"        { set id_file $value }
        "-j-i"      { set jumper_id_file $value }
        "-action"   { set action $value }
        "-local"    { set local_path $value }
        "-remote"   { set remote_path $value }
        "-print-command" { set print_command $value }
        "-proxy-command" { set custom_proxy_command $value }
        "-tunnel-proxy-command" { set tunnel_proxy_command $value }
        "-host-key-checking" { set host_key_checking $value }
        default {
            puts "Error: unknown option $arg"
            exit 1
        }
    }
}

if {$host == "" || $user == "" || $action == ""} {
    puts "Usage: sftp_login.exp -h <host> -u <user> -action <upload|download|interactive> -local <path> -remote <path>"
    exit 1
}

if {$action != "upload" && $action != "download" && $action != "interactive"} {
    puts "Usage: sftp_login.exp -h <host> -u <user> -action <upload|download|interactive> -local <path> -remote <path>"
    exit 1
}

if {$action != "interactive" && ($local_path == "" || $remote_path == "")} {
    puts "Usage: sftp_login.exp -h <host> -u <user> -action <upload|download> -local <path> -remote <path>"
    exit 1
}

if {[info exists env(SSHGO_TARGET_PASS)]} {
    set target_pass $env(SSHGO_TARGET_PASS)
    unset env(SSHGO_TARGET_PASS)
}
if {[info exists env(SSHGO_JUMPER_PASS)]} {
    set jumper_pass $env(SSHGO_JUMPER_PASS)
    unset env(SSHGO_JUMPER_PASS)
}
if {[info exists env(SSHGO_MFA_SECRET)]} {
    set mfa_secret $env(SSHGO_MFA_SECRET)
    unset env(SSHGO_MFA_SECRET)
}
if {[info exists env(SSHGO_JUMPER_MFA_SECRET)]} {
    set jumper_mfa_secret $env(SSHGO_JUMPER_MFA_SECRET)
    unset env(SSHGO_JUMPER_MFA_SECRET)
}
if {[info exists env(SSHGO_PYTHON_EXECUTABLE)]} {
    set python_executable $env(SSHGO_PYTHON_EXECUTABLE)
    unset env(SSHGO_PYTHON_EXECUTABLE)
}

# Get auth.py path
set script_dir [file dirname [file normalize [info script]]]
set auth_py [file join $script_dir "auth.py"]
set ssh_wrapper_py [file join $script_dir "sftp_ssh_wrapper.py"]

proc restore_terminal_echo {} {
    global has_tty
    if {$has_tty} {
        catch {stty echo}
    }
}

proc cleanup {} {
    global batch_path
    catch {close}
    if {$batch_path != ""} {
        catch {file delete -force $batch_path}
        set batch_path ""
    }
    restore_terminal_echo
}

proc fail {message code} {
    cleanup
    puts $message
    exit $code
}

proc target_string {user host} {
    if {$user == ""} {
        return $host
    }
    return "$user@$host"
}

proc bracket_ipv6_host {host} {
    if {[string first ":" $host] >= 0 && ![regexp {^\[.*\]$} $host]} {
        return [format {[%s]} $host]
    }
    return $host
}

proc sftp_target_string {user host} {
    return [target_string $user [bracket_ipv6_host $host]]
}

proc split_host_port {target default_port} {
    if {[regexp {^([^@]+@)?\[(.+)\]:([0-9]+)$} $target -> user_prefix host port]} {
        return [list "${user_prefix}${host}" $port]
    }
    if {[regexp {^([^@]+@)?\[(.+)\]$} $target -> user_prefix host]} {
        return [list "${user_prefix}${host}" $default_port]
    }
    if {[regexp {^(.+):([0-9]+)$} $target -> base port]} {
        set host_part $base
        if {[regexp {^[^@]+@(.+)$} $base -> host_part]} {}
        if {[string first ":" $host_part] < 0} {
            return [list $base $port]
        }
    }
    return [list $target $default_port]
}

proc prompt_token_boundary {ch side} {
    if {$ch == "" || $ch == " " || $ch == "\t"} {
        return 1
    }
    if {$side == "before"} {
        return [expr {[string first $ch {'"([}] >= 0}]
    }
    return [expr {[string first $ch {'")]:}] >= 0}]
}

proc prompt_token_matches {text token} {
    if {$token == ""} {
        return 0
    }

    set haystack [string tolower $text]
    set needle [string tolower $token]
    set haystack_length [string length $haystack]
    set needle_length [string length $needle]
    set search_from 0

    while {$search_from <= $haystack_length} {
        set index [string first $needle $haystack $search_from]
        if {$index < 0} {
            return 0
        }

        set before ""
        if {$index > 0} {
            set before [string index $haystack [expr {$index - 1}]]
        }
        set after_index [expr {$index + $needle_length}]
        set after ""
        if {$after_index < $haystack_length} {
            set after [string index $haystack $after_index]
        }

        if {
            [prompt_token_boundary $before "before"]
            && [prompt_token_boundary $after "after"]
        } {
            return 1
        }
        set search_from [expr {$index + 1}]
    }
    return 0
}

proc prompt_line {buffer} {
    set normalized [string map [list "\r" "\n"] $buffer]
    return [lindex [split $normalized "\n"] end]
}

proc prompt_auth_stage {prompt} {
    global jumper user host id_file jumper_id_file
    if {$jumper == ""} {
        return "target"
    }
    lassign [split_host_port $jumper "22"] jumper_target _
    set jump_match 0
    set target_match 0
    if {$jumper_id_file != "" && [prompt_token_matches $prompt $jumper_id_file]} {
        set jump_match 1
    }
    if {$id_file != "" && [prompt_token_matches $prompt $id_file]} {
        set target_match 1
    }
    if {[prompt_token_matches $prompt $jumper_target]} {
        set jump_match 1
    }
    if {[prompt_token_matches $prompt "$user@$host"]} {
        set target_match 1
    }
    if {$jump_match && !$target_match} {
        return "jump"
    }
    if {$target_match && !$jump_match} {
        return "target"
    }
    return ""
}

proc auth_response_for_prompt {kind} {
    global expect_out jumper_pass target_pass jumper_mfa_secret mfa_secret python_executable auth_py
    set stage [prompt_auth_stage [prompt_line $expect_out(buffer)]]
    if {$kind == "password"} {
        if {$stage == "jump"} {
            return $jumper_pass
        }
        if {$stage == "target"} {
            return $target_pass
        }
    }
    if {$kind == "mfa"} {
        if {$stage == "jump" && $jumper_mfa_secret != ""} {
            return [exec $python_executable $auth_py - << $jumper_mfa_secret]
        }
        if {$stage == "target" && $mfa_secret != ""} {
            return [exec $python_executable $auth_py - << $mfa_secret]
        }
    }
    return ""
}

proc wait_exit_status {} {
    set wait_result [wait]
    if {[llength $wait_result] >= 4} {
        if {[llength $wait_result] > 4} {
            catch {puts stderr "Warning: sftp process did not exit normally: $wait_result"}
            return 1
        }
        set exit_status [lindex $wait_result 3]
        if {[string is integer -strict $exit_status]} {
            return $exit_status
        }
    }
    catch {puts stderr "Warning: unexpected process wait result: $wait_result"}
    return 1
}

proc finish_with_status {exit_status} {
    if {$exit_status != "0"} {
        fail "\nFile transfer failed with exit status $exit_status.\n" 1
    }
    cleanup
    exit 0
}

proc finish_interactive_with_status {exit_status} {
    global interactive_prompt_seen interactive_user_handoff_started
    if {$exit_status != "0"} {
        fail "\nInteractive SFTP exited with status $exit_status.\n" 1
    }
    if {$interactive_prompt_seen == 0 && $interactive_user_handoff_started == 0} {
        fail "\nInteractive SFTP ended before prompt.\n" 1
    }
    cleanup
    exit 0
}

proc finish_action_with_status {exit_status} {
    global action
    if {$action == "interactive"} {
        finish_interactive_with_status $exit_status
    }
    finish_with_status $exit_status
}

proc cleanup_and_exit {code} {
    cleanup
    exit $code
}

trap {cleanup_and_exit 130} INT
trap {cleanup_and_exit 143} TERM
trap {cleanup_and_exit 129} HUP

proc shell_quote {value} {
    set escaped [string map {"'" "'\\''"} $value]
    return "'$escaped'"
}

proc shell_join {parts} {
    set quoted [list]
    foreach part $parts {
        lappend quoted [shell_quote $part]
    }
    return [join $quoted " "]
}

proc sftp_batch_command {} {
    global action local_path remote_path
    switch -exact -- $action {
        "upload" {
            return "put \"$local_path\" \"$remote_path\""
        }
        "download" {
            return "get \"$remote_path\" \"$local_path\""
        }
        default {
            fail "Error: action must be upload or download." 1
        }
    }
}

proc cleanup_stale_batch_files {temp_dir} {
    global stale_batch_seconds
    set now [clock seconds]
    foreach stale_path [glob -nocomplain [file join $temp_dir "sshgo-sftp-*.batch"]] {
        if {![file isfile $stale_path]} {
            continue
        }
        if {[catch {set mtime [file mtime $stale_path]}]} {
            continue
        }
        if {$now - $mtime > $stale_batch_seconds} {
            catch {file delete -force $stale_path}
        }
    }
}

proc create_batch_file {} {
    global batch_path
    set temp_dir "/tmp"
    if {[info exists ::env(TMPDIR)] && [file isdirectory $::env(TMPDIR)]} {
        set temp_dir $::env(TMPDIR)
    }

    cleanup_stale_batch_files $temp_dir

    set command [sftp_batch_command]
    for {set i 0} {$i < 100} {incr i} {
        set candidate [file join $temp_dir "sshgo-sftp-[pid]-[clock clicks]-$i.batch"]
        if {[catch {set ch [open $candidate {WRONLY CREAT EXCL} 0600]}]} {
            continue
        }
        if {[catch {
            fconfigure $ch -encoding utf-8 -translation lf
            puts $ch $command
            close $ch
            file attributes $candidate -permissions 0600
        } err]} {
            catch {close $ch}
            catch {file delete -force $candidate}
            fail "Error: unable to write SFTP batch file: $err" 1
        }
        set batch_path $candidate
        return $batch_path
    }

    fail "Error: unable to create SFTP batch file." 1
}

proc build_sftp_command {batch_file} {
    global host user port jumper id_file host_key_checking custom_proxy_command tunnel_proxy_command ssh_wrapper_py action

    if {$action == "interactive"} {
        set cmd [list sftp -o ConnectTimeout=10]
    } else {
        set cmd [list sftp -b $batch_file -S $ssh_wrapper_py -o ConnectTimeout=10]
    }
    if {$host_key_checking == "no"} {
        lappend cmd -o StrictHostKeyChecking=no
        lappend cmd -o UserKnownHostsFile=/dev/null
    } else {
        lappend cmd -o StrictHostKeyChecking=$host_key_checking
    }
    if {$port != "22"} { lappend cmd -P $port }
    if {$id_file != ""} { lappend cmd -i $id_file }
    if {$jumper != ""} {
        if {$tunnel_proxy_command == ""} {
            fail "Error: missing tunnel proxy command." 1
        }
        lappend cmd -o "ProxyCommand=$tunnel_proxy_command"
    } elseif {$custom_proxy_command != ""} {
        lappend cmd -o "ProxyCommand=$custom_proxy_command"
    }
    lappend cmd [sftp_target_string $user $host]
    return $cmd
}

proc ensure_ssh_wrapper_executable {} {
    global ssh_wrapper_py

    if {![file exists $ssh_wrapper_py]} {
        fail "Error: missing sftp_ssh_wrapper.py." 1
    }
    if {![file executable $ssh_wrapper_py]} {
        catch {file attributes $ssh_wrapper_py -permissions 0755}
    }
    if {![file executable $ssh_wrapper_py]} {
        fail "Error: sftp_ssh_wrapper.py is not executable." 1
    }
}

# Adjust window size on WINCH signal
trap {
    set rows [stty rows]
    set cols [stty columns]
    stty rows $rows columns $cols < $spawn_out(slave,name)
} WINCH

if {$print_command != ""} {
    if {$action == "interactive"} {
        set cmd [build_sftp_command ""]
        puts [shell_join $cmd]
        exit 0
    }
    set batch_preview [sftp_batch_command]
    set cmd [build_sftp_command "<sshgo-generated-batch-file>"]
    puts [shell_join $cmd]
    puts "# batch: $batch_preview"
    exit 0
}

if {$action == "interactive"} {
    set cmd [build_sftp_command ""]
} else {
    ensure_ssh_wrapper_executable
    set cmd [build_sftp_command [create_batch_file]]
}

set timeout 20

# Disable terminal echo to prevent password/username leakage when a TTY exists.
if {$has_tty} {
    stty -echo
}

log_user 0
if {[catch {spawn {*}$cmd} spawn_error]} {
    log_user 1
    fail "\nError executing sftp: $spawn_error\n" 1
}
configure_utf8_channel $spawn_id
log_user 1

if {$action == "interactive"} {
    puts "Connecting to $user@$host for interactive sftp..."
} else {
    puts "Connecting to $user@$host for $action..."
}

# Main expect loop for authentication
expect {
    -re {Are you sure you want to continue connecting.*yes/no} {
        send "yes\r"
        exp_continue
    }
    -re {(?i)((password|passphrase)[: ]*|enter passphrase for key [^\r\n]*:) *$} {
        set response [auth_response_for_prompt "password"]
        if {$response != ""} {
            send "$response\r"
            exp_continue
        } else {
            if {$action == "interactive"} {
                set interactive_user_handoff_started 1
            }
            interact
            finish_action_with_status [wait_exit_status]
        }
    }
    -re {(?i)(MFA|OTP|Verification code).*:} {
        set response [auth_response_for_prompt "mfa"]
        if {$response != ""} {
            send "$response\r"
            exp_continue
        }
        if {$action == "interactive"} {
            set interactive_user_handoff_started 1
        }
        interact
        finish_action_with_status [wait_exit_status]
    }
    -re {sftp> *} {
        if {$action == "interactive"} {
            set interactive_prompt_seen 1
            set interactive_user_handoff_started 1
            restore_terminal_echo
            interact
            finish_action_with_status [wait_exit_status]
        }
        exp_continue
    }
    -re {(?i)Operation timed out} {
        fail "\nError: Connection to host timed out." 1
    }
    eof {
        finish_action_with_status [wait_exit_status]
    }
    timeout {
        fail "\n\nConnection timed out.\n" 1
    }
}

cleanup
